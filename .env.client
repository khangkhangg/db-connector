# Windows Client Configuration
# Copy this to .env for local Windows client use

# Application Mode
NODE_ENV=development

# Server Configuration
API_PORT=3000
API_HOST=0.0.0.0

# Disable authentication for local Windows client
API_ENABLE_AUTH=false

# Logging
LOG_LEVEL=info
LOG_FORMAT=console

# OPTIONAL: Connection Pool
CONNECTION_POOL_MIN=1
CONNECTION_POOL_MAX=10
CONNECTION_TIMEOUT=30000
REQUEST_TIMEOUT=120000

# OPTIONAL: Default SQL Server (leave empty for auto-discovery)
# DEFAULT_MSSQL_SERVER=localhost
# DEFAULT_MSSQL_DATABASE=master
