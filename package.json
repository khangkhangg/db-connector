{
  "name": "db-schema-mapper-connector",
  "version": "0.1.0",
  "description": "Database connector to map schema from local DB (MSSQL/MySQL) to remote application",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "db-connector": "./dist/cli/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "client": "API_ENABLE_AUTH=false ts-node src/index.ts",
    "client:build": "npm run build && API_ENABLE_AUTH=false node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node dist/index.js",
    "discover": "ts-node src/cli/discover-command.ts",
    "discover:examples": "ts-node examples/auto-discover-mssql.ts"
  },
  "keywords": [
    "database",
    "schema",
    "mapper",
    "mssql",
    "mysql",
    "connector"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "mssql": "^10.0.2",
    "mysql2": "^3.6.5",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "joi": "^17.11.0",
    "commander": "^11.1.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "@types/mssql": "^9.1.4",
    "@types/jest": "^29.5.10",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcrypt": "^5.0.2",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
