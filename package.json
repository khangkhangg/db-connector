{
  "name": "db-schema-mapper-connector",
  "version": "0.1.0",
  "description": "Database connector to map schema from local DB (MSSQL/MySQL) to remote application",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node dist/index.js"
  },
  "keywords": [
    "database",
    "schema",
    "mapper",
    "mssql",
    "mysql",
    "connector"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "mssql": "^10.0.2",
    "mysql2": "^3.6.5",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "joi": "^17.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "@types/mssql": "^9.1.4",
    "@types/jest": "^29.5.10",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
